# Copy this file to ".env" and edit. All lines are optional.
# Public address people use to open the app (needed for unsubscribe links in emails).
BASE_URL=http://localhost:5000
PORT=5000
# Default postal address for new accounts (each client can change it in Settings > Sending rules).
POSTAL_ADDRESS=
# 1 = anyone can sign up, 0 = only existing users can log in (set 0 after you created your accounts).
ALLOW_SIGNUP=1
# Optional: "Connect with Gmail" button (Google Cloud OAuth). Leave empty to use Gmail App Password instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seconds to wait between requests to the same website (be polite).
FETCH_DELAY=3
